   3.919950549942176*^9, 3.919950603369024*^9, 3.920119282443516*^9, 
   3.920119434729727*^9, 3.920319106665062*^9, 3.920319380358998*^9, 
   3.920319494643787*^9, {3.92032064286978*^9, 3.920320645366352*^9}, 
