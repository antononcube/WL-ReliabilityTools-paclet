Cell["Here we split the data into training and testing parts:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.9197557185583267`*^9, 3.9197557317209673`*^9}},
 CellID->2119321859,ExpressionUUID->"7d2690fc-d825-4145-af7b-722d1beaaaa8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"splitPos", "=", 
   RowBox[{"Length", "@", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"tsData", "[", "\"\<Times\>\"", "]"}], ",", 
      RowBox[{
       RowBox[{"#", "\[LessEqual]", 
        RowBox[{"AbsoluteTime", "[", "splitDate", "]"}]}], "&"}]}], "]"}]}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"training", ",", "testing"}], "}"}], "=", 
   RowBox[{"TakeDrop", "[", 
    RowBox[{
     RowBox[{"QuantityMagnitude", "[", 
      RowBox[{"tsData", "[", "\"\<Path\>\"", "]"}], "]"}], ",", "splitPos"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "/@", 
  RowBox[{"{", 
   RowBox[{"training", ",", "testing"}], "}"}]}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.919755739373622*^9, 3.919755791044118*^9}, {
  3.919756200004177*^9, 3.91975620062184*^9}, {3.919756360396508*^9, 
  3.919756361565438*^9}, {3.919756420853408*^9, 3.9197565682085667`*^9}, {
  3.91975676118897*^9, 3.919756762204273*^9}},
 CellLabel->"In[4]:=",
 CellID->688417585,ExpressionUUID->"1928e9cb-a35b-4be2-80d7-38aeb054de94"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"173", ",", "115"}], "}"}]], "Output",
 TaggingRules->{},
 CellChangeTimes->{{3.9197557640175543`*^9, 3.919755791397953*^9}, 
   3.919756203154068*^9, {3.91975633546964*^9, 3.919756352096171*^9}, {
   3.919756549374593*^9, 3.919756568702099*^9}, 3.9197566659683523`*^9, 
   3.919756701556212*^9, 3.919756762524906*^9, 3.919756804048498*^9, 
