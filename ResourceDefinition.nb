Cell["\<\
Reliability-related algorithms and know-how encapsulated in convenient model, \
data, and plotting functions.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.914884034127153*^9, 3.914884072101665*^9}, {
  4.000829384406288*^9, 4.0008294187659197`*^9}},
 CellTags->"DefaultContent",
 CellID->441612482,ExpressionUUID->"d26dfb32-7906-4b8c-a5e9-c92cb6fb797f"]
}, Open  ]],

