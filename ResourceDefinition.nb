Cell["Here we get the positions of the anomalies:", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.919755828831883*^9, 3.91975586647573*^9}},
 CellID->104609201,ExpressionUUID->"2f02330a-35a7-47dd-9148-5a8712879ec8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pos", "=", 
   RowBox[{"AnomalyFinder", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"training", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
       RowBox[{"testing", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], 
     ",", "\"\<AnomalyPositions\>\"", ",", 
     RowBox[{"Method", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<GNNMon\>\"", ",", 
        RowBox[{"\"\<NumberOfNearestNeighbors\>\"", "->", "10"}], ",", 
        RowBox[{"\"\<OutlierIdentifier\>\"", "->", "\"\<Quartile\>\""}]}], 
       "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Shallow", "[", "pos", "]"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.91975546400247*^9, 3.919755479542499*^9}, {
   3.919755597353753*^9, 3.919755621786111*^9}, 3.919755702659808*^9, {
