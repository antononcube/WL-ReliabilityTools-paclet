}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Theoretical background", "Section",
 CellChangeTimes->{{4.0020191282943163`*^9, 4.002019134998151*^9}},
 CellID->1029008490,ExpressionUUID->"ca94c6b3-db7a-4dbb-9354-58fa12760b98"],

Cell[TextData[{
 StyleBox["Problem formulation:",
  FontWeight->"Bold"],
 " Assuming production data for different years plot the time evolution of \
the Weibull model ",
 StyleBox["knee",
  FontSlant->"Italic"],
 " point."
}], "Text",
 CellChangeTimes->{{4.0020206129844627`*^9, 4.0020206448507347`*^9}, {
  4.002021466089204*^9, 4.0020214679778223`*^9}},
 CellID->1098939143,ExpressionUUID->"f90c6387-9695-4b89-acfc-a918588c4862"],

Cell[TextData[{
 StyleBox["Remark:",
  FontWeight->"Bold"],
 " From regression (i.e. model fitting) point of view the Weibull plot knee \
is a structural break."
}], "Text",
 CellChangeTimes->{{4.0020214594754744`*^9, 4.002021519490014*^9}},
 CellID->83140161,ExpressionUUID->"afa95b78-2096-4a1e-ae79-0a93872ae544"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Data model", "Section",
 CellChangeTimes->{{4.002017770350566*^9, 4.002017772687851*^9}, {
  4.002027065281066*^9, 4.002027065883247*^9}},
 CellID->1956440140,ExpressionUUID->"d15a9fb1-143d-4c70-a90a-627e243ba671"],

Cell["Consider the following setup scenario: ", "Text",
 CellChangeTimes->{{4.0020274421516953`*^9, 4.0020274543575163`*^9}},
 CellID->350068782,ExpressionUUID->"a569d968-b9d3-4c2f-b7b5-8a8612bf7305"],

Cell[TextData[{
 "Simulated is the weekly output of a set of ",
 StyleBox["nPlants", "Program"],
 " independent production lines over ",
 Cell[BoxData[
 "k"], "InlineFormula",ExpressionUUID->"feda4dc0-ea8e-4593-a1e7-4ed7a8cd12a6"],
 " weeks. "
}], "Item",
 CellChangeTimes->{{4.002027477577848*^9, 4.002027504565452*^9}, {
  4.002032955327242*^9, 4.00203296026055*^9}},
 CellID->1214217479,ExpressionUUID->"55e84f3b-ff1e-4b4b-90bc-476e3fa0e41c"],

Cell[TextData[{
 "Each plant starts from a common baseline of ",
 Cell[BoxData["nUnits"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "2256e870-acdf-4962-835d-0c27ecd26cb4"],
 " units per week and follows two superimposed effects over time. "
}], "Item",
 CellChangeTimes->{{4.002027477577848*^9, 4.0020275099049463`*^9}, 
   4.0020276380112*^9, {4.0020329931411057`*^9, 4.002033001576233*^9}},
 CellID->1963064882,ExpressionUUID->"64ff3491-c87d-45c4-9f3d-224fd0704435"],

Cell["\<\
For each plant there is a plant-specific random weekly multiplicative gain \
which:\
\>", "Item",
 CellChangeTimes->{{4.002027477577848*^9, 4.0020275164610367`*^9}, {
  4.002027550388814*^9, 4.0020275975649157`*^9}, {4.0020276765404882`*^9, 
  4.002027682123403*^9}},
 CellID->398722661,ExpressionUUID->"b1b5d8ab-8e67-40b0-8be9-3e85c7f00036"],

Cell[TextData[{
 "Is drawn from ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["NormalDistribution",
    BaseStyle->"Link"], "[", 
   RowBox[{"0.002", ",", " ", "0.001"}], "]"}]], "InlineFormula",
  ExpressionUUID->"4666197a-f4bd-4cf5-be13-f5fe8aa3013b"]
}], "Subitem",
 CellChangeTimes->{{4.002027477577848*^9, 4.0020275164610367`*^9}, {
  4.002027550388814*^9, 4.0020275975649157`*^9}, {4.0020276765404882`*^9, 
  4.00202772889235*^9}, {4.0020330461645947`*^9, 4.002033047379084*^9}, {
  4.0020330784451447`*^9, 4.002033098538612*^9}},
 CellID->1565850882,ExpressionUUID->"386737c7-0f72-4b8d-84b5-ea4b79dc963c"],

Cell["Compounds week-on-week", "Subitem",
 CellChangeTimes->{{4.002027477577848*^9, 4.0020275164610367`*^9}, {
  4.002027550388814*^9, 4.0020275975649157`*^9}, {4.0020276765404882`*^9, 
  4.002027697004195*^9}, {4.002027731455715*^9, 4.002027731593421*^9}},
 CellID->1765331283,ExpressionUUID->"1300783a-b3f5-4a3d-8428-901f3d034405"],

Cell["Represents idiosyncratic learning/ productivity improvement ", "Subitem",
 CellChangeTimes->{{4.002027477577848*^9, 4.0020275164610367`*^9}, {
  4.002027550388814*^9, 4.0020275975649157`*^9}, {4.0020276765404882`*^9, 
  4.002027735956552*^9}},
 CellID->1270191523,ExpressionUUID->"42441ae1-f2a9-4e99-b81f-4070894ba9fa"],

Cell[TextData[{
 "Independently, each plant draws a random \
\[OpenCurlyDoubleQuote]time-to-degradation\[CloseCurlyDoubleQuote] from a ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["WeibullDistribution",
    BaseStyle->"Link"], "[", 
   RowBox[{"2.5", ",", " ", "45"}], "]"}]], "InlineFormula",ExpressionUUID->
  "991d899a-2f21-4728-b5c1-11071b1d7d8f"],
 " distribution. "
}], "Item",
 CellChangeTimes->{{4.002027477577848*^9, 4.002027528356615*^9}, {
  4.002027761233148*^9, 4.002027822632346*^9}},
 CellID->1208525746,ExpressionUUID->"2d2efb7e-ba41-412c-8ed4-3a45c457d351"],

Cell[TextData[{
 "Until that failure time is reached the plant produces only under the \
improvement factor; once ",
 Cell[BoxData[
 "t"], "InlineFormula",ExpressionUUID->"2f32e1b2-5680-4254-9780-66cb0fa895b4"],
 " exceeds the plant\[CloseCurlyQuote]s failure time an additional \
exponential decay kicks in at a plant-specific rate drawn from ",
 Cell[BoxData[
  RowBox[{
   ButtonBox["UniformDistribution",
    BaseStyle->"Link"], "[", 
   RowBox[{"{", 
    RowBox[{"0.005", ",", "0.025"}], "}"}], "]"}]], "InlineFormula",
  ExpressionUUID->"f10684fd-264b-4206-bb0b-c333e6912e75"],
 " per week, applied to the improvement-adjusted baseline. "
}], "Item",
 CellChangeTimes->{{4.002027477577848*^9, 4.002027528356615*^9}, {
  4.002027761233148*^9, 4.002027861750853*^9}},
 CellID->122630926,ExpressionUUID->"d10b862f-55da-4eb8-b023-cc5d5554ad5c"],

Cell[TextData[{
 "The realized weekly output for plant ",
 Cell[BoxData[
 "i"], "InlineFormula",ExpressionUUID->"f905b566-665a-4603-acaf-b3655b3ef91e"],
 " at week ",
 Cell[BoxData[
 "t"], "InlineFormula",ExpressionUUID->"5794f5a1-2be9-497c-877d-a2cd110f93bd"],
 " is the baseline ",
 Cell[BoxData[
 "nUnits"], "InlineFormula",ExpressionUUID->
  "845681e0-af00-4d5d-a0b3-67635c664d28"],
 " multiplied by ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "+", "improvement_i"}], ")"}], "^", "t", " "}]], 
  "InlineFormula",ExpressionUUID->"47a53563-91d7-4ec9-931c-fa7df5557d2c"],
 "and, after failure, by ",
 Cell[BoxData[
  RowBox[{"Exp", "[", 
   RowBox[{
    RowBox[{"\[Minus]", 
     SubscriptBox["degradationRate", "i"]}], "*", 
    RowBox[{"Max", "[", 
     RowBox[{"0", ",", " ", 
      RowBox[{"t", "\[Minus]", 
       SubscriptBox["failureTime", "i"]}]}], "]"}]}], "]"}]], "InlineFormula",
  ExpressionUUID->"0d3cd5ca-1737-4159-ae8f-778e158e7e60"],
 ", rounded to an integer. "
}], "Item",
 CellChangeTimes->{{4.002027477577848*^9, 4.002027499396657*^9}, {
  4.0020281128845787`*^9, 4.0020281762338877`*^9}, {4.0020331655103607`*^9, 
  4.002033166435533*^9}},
 CellID->1740738974,ExpressionUUID->"3baaeda4-098d-4931-9b78-e59005eca72f"],

Cell[TextData[{
 "Of interest is the cross-section of outputs at week ",
 Cell[BoxData["52"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "782d0ce3-4b47-4bcf-bbe4-b55b0ca9c144"],
 " and the full ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{"0", ",", "1", ",", "...", ",", "k"}], ")"}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "67ffe211-42fa-44b1-8a48-1b7190d1a7fc"],
 " weekly histories for all plants."
}], "Item",
 CellChangeTimes->{{4.002027477577848*^9, 4.002027499396657*^9}, {
  4.0020281128845787`*^9, 4.0020282306341133`*^9}},
 CellID->1146675369,ExpressionUUID->"5beaa2b9-7dc4-4e48-8350-69089ac62449"],

Cell[CellGroupData[{

Cell["Code for the data model", "Subsection",
 CellChangeTimes->{{4.002028261145196*^9, 4.0020282671598663`*^9}},
 CellID->532441450,ExpressionUUID->"907084ab-372b-4d03-abd4-15d233fba0c5"],

Cell[CellGroupData[{

Cell["Random seed setup (for reproducible results)", "MathCaption",
 CellChangeTimes->{{4.0020270793516912`*^9, 4.0020271007264357`*^9}},
 CellID->1526672164,ExpressionUUID->"20e03d60-883a-48f6-bf43-6a994faedc6f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1234", "]"}], ";"}]], "Input",
 CellChangeTimes->{{4.000458443190995*^9, 4.000458448467991*^9}, {
  4.0017004069030933`*^9, 4.001700407394424*^9}, {4.001701219964287*^9, 
  4.001701220711278*^9}},
 CellLabel->"In[4]:=",
 CellID->1990650344,ExpressionUUID->"8afe24de-9c95-4672-9805-3d3f89f8ea29"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parameters:", "MathCaption",
 CellChangeTimes->{{4.000458443190995*^9, 4.000458470920245*^9}, {
  4.0004706613339577`*^9, 4.0004706773656807`*^9}},
 CellID->1212594995,ExpressionUUID->"49706e97-fe26-4164-82f3-b5fbd396d9a5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"nPlants", "=", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nUnits", "=", "1200"}], ";"}], "   ", 
  RowBox[{"(*", 
   RowBox[{"Initial", " ", "weekly", " ", "production"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"k", "=", "52"}], ";"}], "                  ", 
  RowBox[{"(*", 
   RowBox[{"Number", " ", "of", " ", "weeks"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"beta", "=", "2.5"}], ";"}], "         ", 
  RowBox[{"(*", 
   RowBox[{"Weibull", " ", "shape"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eta", "=", "45"}], ";"}], "              ", 
  RowBox[{"(*", 
   RowBox[{"Weibull", " ", "characteristic", " ", "life"}], 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{4.000458443190995*^9, 4.000458470920245*^9}, {
  4.0004706613339577`*^9, 4.0004706726499233`*^9}, {4.001497068525858*^9, 
  4.001497068854081*^9}, {4.001497137643873*^9, 4.001497137883465*^9}, {
  4.001497460085641*^9, 4.0014974660554*^9}, {4.00202839394184*^9, 
  4.002028406333931*^9}, {4.002029089531889*^9, 4.00202910624326*^9}},
 CellLabel->"In[5]:=",
 CellID->464270935,ExpressionUUID->"743e1bcd-8b4c-4de8-947a-f0ec9768e200"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Time until production degradation", "MathCaption",
 CellChangeTimes->{{4.000470603251947*^9, 4.000470603778256*^9}, 
   4.002028278709996*^9},
 CellID->1193514994,ExpressionUUID->"a8bce172-e804-4df3-bb25-f8cc810c2077"],

Cell[BoxData[
 RowBox[{
  RowBox[{"failureTimes", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"WeibullDistribution", "[", 
      RowBox[{"beta", ",", "eta"}], "]"}], ",", "nPlants"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.000458443190995*^9, 4.0004584746555243`*^9}, 
   4.0004706055191298`*^9},
 CellLabel->"In[10]:=",
 CellID->1909241178,ExpressionUUID->"a2936940-aaa5-44b3-aee2-74aba68abcbb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Weekly productivity improvement", "MathCaption",
 CellChangeTimes->{{4.000470610271989*^9, 4.000470614489794*^9}, 
   4.002028282744594*^9},
 CellID->915825172,ExpressionUUID->"906d9d58-2c0f-4a33-ae1a-64728bcd170a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"improvements", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0.002", ",", "0.001"}], "]"}], ",", "nPlants"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.000458443190995*^9, 4.0004584763500423`*^9}, 
   4.000470615942951*^9},
 CellLabel->"In[11]:=",
 CellID->1258367755,ExpressionUUID->"13556eaf-8796-4bf8-bff8-49594ae88c67"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Weekly production degradation factors", "MathCaption",
 CellChangeTimes->{{4.00047061973981*^9, 4.000470622106551*^9}, 
   4.0020282865248833`*^9},
 CellID->967902629,ExpressionUUID->"3e38ab98-1937-47ae-aceb-b8d907af3fcb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"degradationRates", "=", 
   RowBox[{"RandomVariate", "[", 
    RowBox[{
     RowBox[{"UniformDistribution", "[", 
      RowBox[{"{", 
       RowBox[{"0.005", ",", "0.025"}], "}"}], "]"}], ",", "nPlants"}], 
    "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.000458443190995*^9, 4.000458477762938*^9}, 
   4.000470618074519*^9},
 CellLabel->"In[12]:=",
 CellID->350859578,ExpressionUUID->"2156840e-fb40-4845-a665-7139c6413477"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Production of plant ",
 Cell[BoxData["i"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "cc2e4d9b-feb3-4968-aeb2-36dfc65bec8b"],
 " at week ",
 Cell[BoxData["t"], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "87b3b300-f389-4b16-a1dd-4fab170b238a"]
}], "MathCaption",
 CellChangeTimes->{{4.000470626038293*^9, 4.000470633311275*^9}, {
  4.0020282957412*^9, 4.002028321189996*^9}},
 CellID->2054316431,ExpressionUUID->"2538fcd0-5bec-4bfe-b4c1-5ce6bc09c30f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "Production", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Production", "[", 
    RowBox[{"i_", ",", "t_"}], "]"}], ":=", 
   RowBox[{"Round", "[", 
    RowBox[{"nUnits", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"improvements", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "^", "t"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"degradationRates", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], " ", 
       RowBox[{"Max", "[", 
        RowBox[{"0", ",", 
         RowBox[{"t", "-", 
          RowBox[{"failureTimes", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.000458443190995*^9, 4.0004584793379097`*^9}, {
   4.000458531041728*^9, 4.0004585382105827`*^9}, 4.000470624330184*^9, {
   4.002029122009934*^9, 4.0020291230434923`*^9}},
 CellLabel->"In[13]:=",
 CellID->1801662998,ExpressionUUID->"9827b05b-7728-46a0-83ac-de7369bc669e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Production after ",
 Cell[BoxData[
  FormBox[
  Cell["k",ExpressionUUID->"c375422b-ba95-4e83-92e4-eb00e149ec54"], 
   TraditionalForm]],ExpressionUUID->"0a96ee4e-e548-454f-8dba-fc65f9f25a19"],
 " weeks"
}], "MathCaption",
 CellChangeTimes->{{4.000470637392791*^9, 4.0004706438612022`*^9}, {
  4.002028311701392*^9, 4.0020283224681683`*^9}},
 CellID->1030584686,ExpressionUUID->"e659de5f-039f-408d-853a-68df18b38258"],

Cell[BoxData[
 RowBox[{
  RowBox[{"productionAtWeek52", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Production", "[", 
      RowBox[{"i", ",", "k"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "nPlants"}], "}"}]}], "]"}]}], ";"}]], "Input",
