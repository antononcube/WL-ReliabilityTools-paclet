Notebook[{

Cell[CellGroupData[{
Cell["Weibull Reliability Modeling for Plant Production", "Title",
 CellID->216149336,ExpressionUUID->"b616e842-ced3-4358-a7c4-b2dc5fe5cce1"],

Cell[CellGroupData[{

Cell["Introduction", "Section",
 CellChangeTimes->{{4.002017657460944*^9, 4.0020176591235*^9}},
 CellID->1510624712,ExpressionUUID->"0aeae941-7008-4453-9d93-bbc4bf7390e5"],

Cell[TextData[{
 "In this document is illustrated how to use Weibull Reliability \
tools/functions provided by the paclet ",
 ButtonBox["\"AntonAntonov/ReliabilityTools\"",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://resources.wolframcloud.com/PacletRepository/resources/\
AntonAntonov/ReliabilityTools/"], None},
  ButtonNote->
   "https://resources.wolframcloud.com/PacletRepository/resources/\
AntonAntonov/ReliabilityTools/"],
 ". The featured paclet functions are ",
 Cell[BoxData[
  ButtonBox["WeibullReliabilityModel",
   BaseStyle->"Link",
   ButtonData->
    "paclet:AntonAntonov/ReliabilityTools/ref/WeibullReliabilityModel"]], 
  "InlineFormula",ExpressionUUID->"25335a05-d492-45a4-b19a-9cffd947f674"],
 " and ",
 Cell[BoxData[
  ButtonBox["WeibullReliabilityPlot",
   BaseStyle->"Link",
   ButtonData->
    "paclet:AntonAntonov/ReliabilityTools/ref/WeibullReliabilityPlot"]], 
  "InlineFormula",ExpressionUUID->"9c46c9a4-df8d-4081-b68a-b6468d1110a5"],
 "."
}], "Text",
 CellChangeTimes->{{4.002017963327022*^9, 4.002018011851852*^9}, {
  4.002018677624793*^9, 4.002018714420595*^9}, {4.002018759663664*^9, 
  4.00201885410074*^9}},
 CellID->1874324849,ExpressionUUID->"0051dc2a-a158-484c-bb65-4dfd5410d1e2"],

Cell["\<\
The document have sections corresponding to the following steps:\
\>", "Text",
 CellChangeTimes->{{4.00201887443134*^9, 4.0020189057213593`*^9}},
 CellID->1093981342,ExpressionUUID->"57dcf5d4-1a92-4cef-93de-c98f22f06fb2"],

Cell["Theoretical background", "Item",
 CellChangeTimes->{{4.00201887443134*^9, 4.002018954647313*^9}, {
  4.002020538193223*^9, 4.002020558667879*^9}},
 CellID->1877713813,ExpressionUUID->"38190e5e-e85d-4c22-bf0c-c3485c4f5ba4"],

Cell["Data generation", "Item",
 CellChangeTimes->{{4.00201887443134*^9, 4.002018974480173*^9}},
 CellID->219565544,ExpressionUUID->"a930dd12-1290-4093-aa32-4cf54b68187d"],

Cell["For one production plant over a range of years", "Subitem",
 CellChangeTimes->{{4.0020189779321957`*^9, 4.00201904249691*^9}},
 CellID->194639029,ExpressionUUID->"5e266f70-cef2-4c51-bd18-ede11c24f354"],

Cell["Derivation of Weibull models", "Item",
 CellChangeTimes->{{4.0020189779321957`*^9, 4.00201904438197*^9}},
 CellID->369392357,ExpressionUUID->"0d8d1d2a-226c-46d1-a5c5-af24eaa8c840"],

Cell[CellGroupData[{

Cell["Setup", "Subsection",
 CellChangeTimes->{{4.002017663324792*^9, 4.0020176640585613`*^9}},
 CellID->597963815,ExpressionUUID->"272b9df8-2502-4fd4-a6bf-aadd1fd3d14c"],

Cell[CellGroupData[{

Cell["Install and load the paclet", "MathCaption",
 CellChangeTimes->{{4.0020176666694517`*^9, 4.0020176756757383`*^9}},
 CellID->1012680201,ExpressionUUID->"94c86c47-9997-4ba1-a606-cbf4c9a5403f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletInstall", "[", "\"\<AntonAntonov/ReliabilityTools\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<AntonAntonov`ReliabilityTools`\>\"", "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.002017687774424*^9, 4.002017709644978*^9}},
 CellLabel->"In[1]:=",
 CellID->1308235732,ExpressionUUID->"900fc767-cee8-415c-9636-e8569d19c379"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Load the \"TypeSystem\" paclet in order get concise summaries of the data\
\>", "MathCaption",
 CellChangeTimes->{{4.002028831708837*^9, 4.002028882497931*^9}},
 CellID->1370830134,ExpressionUUID->"c0b5c36c-2640-4adf-812a-52f0af721efb"],

