Cell[TextData[{
 "There two main ways to deal with these cases: (i) remove the smallest \
values of data and redo the model, and (ii) tweak parameters for structural \
breaks finding of ",
 Cell[BoxData[
  ButtonBox["WeibullReliabilityModel",
   BaseStyle->"Link",
   ButtonData->
    "paclet:AntonAntonov/ReliabilityTools/ref/WeibullReliabilityModel"]], 
  "InlineFormula",ExpressionUUID->"9b8cef4a-9ed7-479b-9ea8-014c6950673f"],
 ". (Both are demonstrated in the function page of that function.)"
}], "Text",
 CellChangeTimes->{{4.002034465907728*^9, 4.0020346095768223`*^9}},
 CellID->407778691,ExpressionUUID->"eef9ec4c-1ecb-482c-a30b-02aaf8cfb5dd"],

Cell[CellGroupData[{

Cell["Remove smallest numbers, remodel, and plot", "MathCaption",
 CellChangeTimes->{{4.002034618863673*^9, 4.00203463105684*^9}},
 CellID->258785230,ExpressionUUID->"5943ac16-9a8e-4fac-9fb4-a09cfc7bb904"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"WeibullReliabilityPlot", "[", 
  RowBox[{
   RowBox[{"WeibullReliabilityModel", "[", 
    RowBox[{"Drop", "[", 
     RowBox[{
      RowBox[{"Sort", "@", 
       RowBox[{
       "productionHistories", "\[LeftDoubleBracket]", "9", 
        "\[RightDoubleBracket]"}]}], ",", "5"}], "]"}], "]"}], ",", 
   RowBox[{"ImageSize", "->", "500"}]}], "]"}]], "Input",
