Cell[CellGroupData[{

Cell["Definitions", "Subsection",
 CellChangeTimes->{{4.002019392135556*^9, 4.0020193955232363`*^9}},
 CellID->280569940,ExpressionUUID->"724f835b-e01c-42fd-a86e-2ab949adb4a8"],

Cell[CellGroupData[{

Cell["\<\
Helper function that computes the plant production for given: \
\[LineSeparator]- Plant index\[LineSeparator]- Time (week index)\
\[LineSeparator]- Plant improvements factors\[LineSeparator]- Plant \
degradation rates\[LineSeparator]- Failure times\
\>", "MathCaption",
 CellChangeTimes->{{4.0020194138548822`*^9, 4.002019482029216*^9}, {
  4.0020203332941713`*^9, 4.0020203965639353`*^9}},
 CellID->1756109269,ExpressionUUID->"e464a61d-4680-4725-836a-73907aea40c8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "Production", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Production", "[", 
    RowBox[{"i_", ",", "t_", ",", 
     RowBox[{"n_", "?", "IntegerQ"}], ",", 
     RowBox[{"improvements", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"_", "?", "NumericQ"}], ".."}], "}"}]}], ",", 
     RowBox[{"degradationRates", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"_", "?", "NumericQ"}], ".."}], "}"}]}], ",", 
     RowBox[{"failureTimes", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"_", "?", "NumericQ"}], ".."}], "}"}]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Round", "[", 
     RowBox[{"n", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"improvements", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "^", "t"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"degradationRates", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], " ", 
        RowBox[{"Max", "[", 
         RowBox[{"0", ",", 
          RowBox[{"t", "-", 
           RowBox[{"failureTimes", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}], "/;", 
    RowBox[{
     RowBox[{"Length", "[", "improvements", "]"}], "==", 
     RowBox[{"Length", "[", "degradationRates", "]"}], "==", 
     RowBox[{"Length", "[", "failureTimes", "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.000458443190995*^9, 4.0004584793379097`*^9}, {
   4.000458531041728*^9, 4.0004585382105827`*^9}, 4.000470624330184*^9, {
   4.002019495231229*^9, 4.002019650216935*^9}, {4.002026715282089*^9, 
   4.002026734423118*^9}, 4.002026831326188*^9, {4.0020286577217703`*^9, 
   4.002028658729357*^9}},
 CellLabel->"In[17]:=",
 CellID->614131525,ExpressionUUID->"b3d2fd1f-b157-4b1b-bcb9-e738840ae9c3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Function that generates plant production numbers of units for given:\
\[LineSeparator]- Number of plants \[LineSeparator]- Expected weekly \
production\[LineSeparator]- Number of weeks\[LineSeparator]- Weibull \
distribution parameters\
\>", "MathCaption",
 CellChangeTimes->{{4.0020200465673*^9, 4.002020106818924*^9}, {
  4.0020202727842083`*^9, 4.0020203075669937`*^9}, {4.002033194877018*^9, 
  4.002033230337475*^9}},
 CellID->243596198,ExpressionUUID->"941c2420-b797-4841-a912-f31deeea6145"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "ProductionDataGeneration", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ProductionDataGeneration", "[", 
    RowBox[{
     RowBox[{"nPlants_", ":", "100"}], ",", 
     RowBox[{"weeklyProductionPerPlant_", ":", "1000"}], ",", 
     RowBox[{"numberOfWeeks_", ":", "52"}], ",", 
     RowBox[{"beta_", ":", "2.5"}], ",", 
     RowBox[{"eta_", ":", "45"}]}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "failureTimes", ",", "improvements", ",", "degradationRates", ",", 
       "productionAtLastWeek", ",", "productionHistories"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"failureTimes", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"WeibullDistribution", "[", 
          RowBox[{"beta", ",", "eta"}], "]"}], ",", "nPlants"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"improvements", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0.002", ",", "0.001"}], "]"}], ",", "nPlants"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"degradationRates", "=", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{
         RowBox[{"UniformDistribution", "[", 
          RowBox[{"{", 
           RowBox[{"0.005", ",", "0.025"}], "}"}], "]"}], ",", "nPlants"}], 
        "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"productionAtLastWeek", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Production", "[", 
          RowBox[{
          "i", ",", "numberOfWeeks", ",", "weeklyProductionPerPlant", ",", 
           "improvements", ",", "degradationRates", ",", "failureTimes"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nPlants"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"productionHistories", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Production", "[", 
          RowBox[{
          "i", ",", "t", ",", "weeklyProductionPerPlant", ",", "improvements",
            ",", "degradationRates", ",", "failureTimes"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "nPlants"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "numberOfWeeks"}], "}"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "productionHistories"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.001497843730389*^9, 4.001498085544589*^9}, 
   4.001498872424449*^9, 4.001498984908894*^9, {4.001499038052643*^9, 
   4.0014990383084993`*^9}, {4.002019635875622*^9, 4.002019692801049*^9}, 
   4.002019731787672*^9, {4.0020266510373487`*^9, 4.002026675080337*^9}, {
   4.002026855506209*^9, 4.00202685605971*^9}},
 CellLabel->"In[19]:=",
 CellID->902133193,ExpressionUUID->"b89eb9bf-d757-4e50-a001-f1b6fa37b9db"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

