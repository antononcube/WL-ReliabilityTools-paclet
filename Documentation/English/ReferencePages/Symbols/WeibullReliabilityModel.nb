  "685e96b3-5c9b-4563-b614-3fdb76ec76c7"],
 "\[LineSeparator]make a Weibull reliability model for given reliability (or \
production) data ",
 Cell[BoxData[
  StyleBox["dta", "TI"]], "InlineFormula",ExpressionUUID->
  "9a831827-56ce-4434-9af9-f87c670c8432"],
 "."
}], "Usage",
 CellChangeTimes->{{4.001493815904167*^9, 4.001493932200732*^9}},
 CellID->600671165,ExpressionUUID->"f2e9f8c3-2a2c-47c9-8e01-4f55611cbbd7"],

Cell["\<\
For a given list of numbers the function applies the Weibull distribution \
heuristic for modeling failures or production output.\
\>", "Notes",
 CellChangeTimes->{{4.001493935379424*^9, 4.001494017218759*^9}, {
  4.001495415696518*^9, 4.0014954156977787`*^9}},
 CellID->159645608,ExpressionUUID->"d14ebb9b-1454-4133-8130-d424b54d754e"],

Cell[TextData[{
 "The function returns a ",
 Cell[BoxData[
  ButtonBox["ReliabilityModel",
   BaseStyle->"Link",
   ButtonData->"paclet:AntonAntonov/ReliabilityTools/ref/ReliabilityModel"]], 
  "InlineFormula",ExpressionUUID->"703af3c7-b6bc-47ca-a889-05323f385a26"],
 " object which can be used as an argument to ",
 Cell[BoxData[
  ButtonBox["WeibullReliabilityPlot",
   BaseStyle->"Link",
   ButtonData->
    "paclet:AntonAntonov/ReliabilityTools/ref/WeibullReliabilityPlot"]], 
  "InlineFormula",ExpressionUUID->"6e03b994-6821-441b-9254-1a154b06adfd"],
 "."
}], "Notes",
 CellChangeTimes->{{4.001493935379424*^9, 4.001494017218759*^9}, {
