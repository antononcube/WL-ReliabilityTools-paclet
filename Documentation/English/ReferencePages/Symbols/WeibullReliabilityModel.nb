Cell["\<\
The structural breaks in the data are found with a Quantile Regression \
monadic pipeline similar to this one:\
\>", "ExampleText",
 CellChangeTimes->{{4.001495845807349*^9, 4.001495892561816*^9}, {
  4.001496516477339*^9, 4.001496527332913*^9}},
 CellID->1589358571,ExpressionUUID->"20115552-1e15-4c1b-bf36-c8f372a4925f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "PacletInstall", "[", "\"\<AntonAntonov/MonadicQuantileRegression\>\"", 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Needs", "[", "\"\<AntonAntonov`MonadicQuantileRegression`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"qrObj", "=", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"QRMonUnit", "[", 
     RowBox[{"rmObj", "[", "\"\<Data\>\"", "]"}], "]"}], "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", 
    RowBox[{"QRMonFindStructuralBreaks", "[", "]"}], "\[DoubleLongRightArrow]",
     "\[IndentingNewLine]", 
    RowBox[{"QRMonPlotStructuralBreakSplits", "[", 
     RowBox[{"ImageSize", "->", "Small"}], "]"}], "\[DoubleLongRightArrow]", 
    "\[IndentingNewLine]", "QRMonTakeValue"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.001495903216707*^9, 4.00149593048169*^9}, {
   4.0014962028986063`*^9, 4.0014962901116447`*^9}, 4.001496424037115*^9},
 CellLabel->"In[15]:=",
 CellID->365531663,ExpressionUUID->"6e37433f-ebf1-4fbd-8443-85373c58f099"],

